# Cloudflare Pages response headers for adam-young.co.uk.
# GitHub Pages could not set response headers at all — this file is the main
# reason to host on Cloudflare Pages. Publish's .copyResources() copies this to
# Output/_headers, which Cloudflare reads at deploy time.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # No Content-Security-Policy yet: the site loads Google Analytics and inline
  # styles, so a strict CSP would break it. Add one deliberately once tested.

# Static assets change rarely and aren't content-hashed, so a day's cache is a
# safe balance between freshness and edge offload.
/assets/*
  Cache-Control: public, max-age=86400

# styles.css changes with design tweaks; keep it short and revalidating.
/styles.css
  Cache-Control: public, max-age=3600, must-revalidate
